<?xml version="1.0" encoding="utf-8"?>
<manifest>
  <control namespace="CustomControls" constructor="ActionCardControl" version="1.0.6"
    display-name-key="ActionCardControl" description-key="Картка з двома діями"
    control-type="standard">

    <property name="taskName" display-name-key="Task Name"
      description-key="Name of the selected task" usage="input" of-type="SingleLine.Text" />
    <property name="statusValue" display-name-key="Status Text"
      description-key="Current status as text" usage="input" of-type="SingleLine.Text" />
    <property name="statusOptions" display-name-key="Status Options"
      description-key="Comma separated list of statuses" usage="input" of-type="SingleLine.Text" />

    <property name="selectedStatus" display-name-key="Selected Status"
      description-key="Status chosen in the dropdown" usage="output" of-type="SingleLine.Text" />

    <event name="OnFlowTrigger" display-name-key="OnFlowTrigger"
      description-key="Fires when Power Automate button is clicked" />
    <event name="OnUpdateRequest" display-name-key="OnUpdateRequest"
      description-key="Fires when Update button is clicked" />

    <resources>
      <code path="index.ts" order="1" />
    </resources>
  </control>
</manifest>